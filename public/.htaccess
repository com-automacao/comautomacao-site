# Com Automação — config Apache para o export estático (HostGator/cPanel)

# Página 404 personalizada do Next
ErrorDocument 404 /404.html

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Nem todo Apache conhece .glb; sem isto a regra de cache abaixo não pega
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>

# Cache de assets estáticos (o Next versiona os arquivos com hash)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # modelos 3D: o nome carrega o hash do conteúdo, então cachear para sempre é
  # seguro — uma troca de modelo vira uma URL nova
  ExpiresByType model/gltf-binary "access plus 1 year"
  # HTML sempre revalida
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
